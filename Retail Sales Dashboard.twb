      <aliases enabled='yes' />
      <column caption='Show Bar' datatype='boolean' name='[Calculation_0305391931027456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]=0' />
      </column>
      <column caption='Total Orders per Category' datatype='integer' name='[Calculation_0445030073479168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Category] : COUNT([Sale_ID]) }' />
      </column>
      <column caption='Selected KPI' datatype='string' name='[Calculation_0445030111727618]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Total Revenue&quot; THEN &quot;Total Revenue&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Total Profit&quot; THEN &quot;Total Profit&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Total Orders&quot; THEN &quot;Total Orders&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Total Quantity Sold&quot; THEN &quot;Total Quantity Sold&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Average Discount %&quot; THEN &quot;Average Discount %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Profit Margin %&quot; THEN &quot;Profit Margin %&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_1908754550358016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Price] * [Quantity] * (1 - [Discount])' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_1908754554003457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Price] - [Cost_Price]) * [Quantity]' />
      </column>
      <column caption='Profit Margin %' datatype='real' name='[Calculation_1908754555822082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM((([Price] - [Cost_Price]) * [Quantity]))&#13;&#10;/&#13;&#10;SUM([Price] * [Quantity])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_1908754557624323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Sale_ID])' />
      </column>
      <column caption='Total Quantity Sold' datatype='integer' name='[Calculation_1908754558660612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])' />
      </column>
      <column caption='Average Discount %' datatype='real' name='[Calculation_1908754560417797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount])' />
      </column>
      <column caption='Total sales' datatype='real' name='[Calculation_1908754571763718]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(Quantity * Price)' />
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Contact Email' datatype='string' name='[Contact_Email]' role='dimension' type='nominal' />
      <column caption='Contact Person' datatype='string' name='[Contact_Person]' role='dimension' type='nominal' />
      <column caption='Cost Price' datatype='real' name='[Cost_Price]' role='measure' type='quantitative' />
      <column caption='Customer ID' datatype='string' name='[Customer_ID]' role='dimension' type='nominal' />
      <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
      <column caption='Product ID' datatype='string' name='[Product_ID]' role='dimension' type='nominal' />
