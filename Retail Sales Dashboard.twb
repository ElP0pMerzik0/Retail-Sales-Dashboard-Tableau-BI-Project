  <worksheets>
    <worksheet name='01_KPI_Total Revenue'>
      <table>
        <view>
          <datasources>
            <datasource caption='Final Product &amp; Sales Data (Retail Data for Lab1)' name='federated.1esmzbk0zi7r6l11agu8z1f4vrkw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Selector' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Profit Margin \%&quot;'>
              <calculation class='tableau' formula='&quot;Profit Margin %&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1esmzbk0zi7r6l11agu8z1f4vrkw'>
            <column caption='Selected KPI' datatype='string' name='[Calculation_0445030111727618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Total Revenue&quot; THEN &quot;Total Revenue&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Total Profit&quot; THEN &quot;Total Profit&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Total Orders&quot; THEN &quot;Total Orders&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Total Quantity Sold&quot; THEN &quot;Total Quantity Sold&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Average Discount %&quot; THEN &quot;Average Discount %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Profit Margin %&quot; THEN &quot;Profit Margin %&quot;&#13;&#10;END' />
            </column>
            <column caption='Total Revenue' datatype='real' name='[Calculation_1908754550358016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Price] * [Quantity] * (1 - [Discount])' />
            </column>
            <column caption='Total Profit' datatype='real' name='[Calculation_1908754554003457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Price] - [Cost_Price]) * [Quantity]' />
            </column>
            <column caption='Profit Margin %' datatype='real' name='[Calculation_1908754555822082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM((([Price] - [Cost_Price]) * [Quantity]))&#13;&#10;/&#13;&#10;SUM([Price] * [Quantity])' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_1908754557624323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Sale_ID])' />
            </column>
            <column caption='Total Quantity Sold' datatype='integer' name='[Calculation_1908754558660612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Quantity])' />
            </column>
            <column caption='Average Discount %' datatype='real' name='[Calculation_1908754560417797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Discount])' />
            </column>
            <column caption='Cost Price' datatype='real' name='[Cost_Price]' role='measure' type='quantitative' />
            <column datatype='real' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='real' name='[Price]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column caption='Sale ID' datatype='integer' name='[Sale_ID]' role='dimension' type='ordinal' />
            <column caption='KPIs' datatype='real' name='[Selected KPI (copy 2)_0445030120546309]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Total Revenue&quot; THEN SUM([Calculation_1908754550358016])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Total Profit&quot; THEN SUM([Calculation_1908754554003457])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Total Orders&quot; THEN ([Calculation_1908754557624323])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Total Quantity Sold&quot; THEN ([Calculation_1908754558660612])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Average Discount %&quot; THEN ([Calculation_1908754560417797])&#13;&#10;ELSE ([Calculation_1908754555822082])&#13;&#10;END' />
            </column>
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Calculation_0445030111727618]' derivation='None' name='[none:Calculation_0445030111727618:nk]' pivot='key' type='nominal' />
            <column-instance column='[Selected KPI (copy 2)_0445030120546309]' derivation='User' name='[usr:Selected KPI (copy 2)_0445030120546309:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
